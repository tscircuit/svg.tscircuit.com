{
  "name": "svg3-tscircuit-com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc -c wrangler.images.jsonc",
    "deploy": "wrangler deploy -c wrangler.images.jsonc && wrangler deploy",
    "check": "tsc --noEmit",
