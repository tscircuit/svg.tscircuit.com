    "test:runtime": "node tests/runtime.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@resvg/resvg-wasm": "2.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260402.1",
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "wrangler": "^4.73.0"
  }
}
