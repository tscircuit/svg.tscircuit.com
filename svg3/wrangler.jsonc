{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svg3-tscircuit-com",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "routes": [{ "pattern": "svg3.tscircuit.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": { "CACHE_VERSION": "v1" },
  // Production image cache for svg3.tscircuit.com.
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "3affdab4aeb2447187d37bce13b65c78" }
  ],
  "containers": [
    {
      "class_name": "Renderer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-3",
      "max_instances": 4
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RENDERER", "class_name": "Renderer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Renderer"] }],
  "queues": {
    "producers": [
      { "binding": "REFRESH_QUEUE", "queue": "svg3-image-refresh" }
    ],
    "consumers": [
      {
        "queue": "svg3-image-refresh",
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 3,
        "dead_letter_queue": "svg3-image-refresh-failed"
      }
    ]
  }
}
